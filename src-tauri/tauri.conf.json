{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Messages Exporter",
  "version": "0.1.2",
  "identifier": "com.rynowastaken.discord-messages-exporter",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Discord message exporter and archive console",
    "longDescription": "Export Discord messages, search the archive, and inspect insights from a self-contained desktop console.",
    "resources": {
      "resources/app/": "app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
